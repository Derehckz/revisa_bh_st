# Configuracion externa (opcional). No subir .env real al repositorio.
BH_RAIZ=E:\Boletas Honorarios
BH_ULT_FECHA_RECEPCION=28 Abril 2026
BH_HORARIO_RECEPCION=19:00
BH_ULT_FECHA_RECORDATORIO=30 Abril 2026
BH_HORARIO_RECORDATORIO=19:00
BH_EMAIL_CONTABILIDAD=contabilidad@santotomas.cl
BH_EMAIL_XML_1=achocano@santotomas.cl
BH_EMAIL_XML_2=
BH_PREFIJO=bhe_

# Base de datos (preferir BH_DB_* para evitar conflictos con variables globales)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boletas_honorarios
DB_USER=boletas_app
DB_PASSWORD=tu_password

BH_DB_HOST=localhost
BH_DB_PORT=5432
BH_DB_NAME=boletas_honorarios
BH_DB_USER=boletas_app
BH_DB_PASSWORD=tu_password

# Seguridad API
BH_API_KEY=define_una_clave_larga_y_unica
# Key anterior para rotacion sin downtime (opcional)
BH_API_KEY_PREVIOUS=
# Multiples keys activas separadas por coma (opcional)
BH_API_KEYS=
# Ejemplo: http://localhost:5173,http://127.0.0.1:5173
BH_API_CORS_ORIGINS=
# Rate limit (in-memory, por IP + API key)
BH_API_RATE_LIMIT_ENABLED=1
BH_API_RATE_LIMIT_MAX_REQUESTS=120
BH_API_RATE_LIMIT_WINDOW_SECONDS=60
# Log JSONL de accesos API
BH_API_ACCESS_LOG_PATH=
# Plazos de correo vía contexto (1=no mutar config global; recomendado)
BH_DEADLINES_VIA_CONTEXT=1
# Stage 0 vía Stage0Service (0=rollback a bridge directo)
BH_STAGE0_SERVICE=1
# Operación/Avance lee PostgreSQL como fuente de verdad (recomendado)
BH_READ_FROM_DB=1
