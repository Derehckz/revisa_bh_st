lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Entornos virtuales
venv/
.venv/
env/
.env/
.env

# Node
node_modules/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Tests y cobertura
.pytest_cache/
.coverage
htmlcov/
