# =============================================================================
# Boletas Honorarios — .gitignore
# =============================================================================

# --- Datos operativos por año/mes (se generan en disco; no van al repo) ---
/[0-9][0-9][0-9][0-9]/

# --- Secretos / entorno local ---
.env
.env.local
.env.*.local

# --- Runtime / estado local ---
logs/
.state/
.logs/
*.sqlite3
*.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.vite/
*.tsbuildinfo
frontend/vite.config.d.ts

# --- Tests / cobertura ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Backups y logs generados ---
*_backup_*.zip
.backups/
*.log
*.jsonl
revision_carpetas.xlsx

# Basura / copias sueltas en raíz (usar 2026/<Mes>/Solicitud.xlsx)
/Solicitud.xlsx


# --- IDE / SO ---
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
nul
desktop.ini
